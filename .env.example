# Entorno de ejecución
FLASK_ENV=development

# Base de datos MySQL
# Formato: mysql+pymysql://usuario:password@host:puerto/base
DATABASE_URI=mysql+pymysql://root:@localhost:3306/api_83

# Clave secreta para JWT (mínimo 32 bytes)
# Puedes generar una con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=supersecretkey1234567890supersecure

# Clave secreta de Flask (para sesiones, CSRF, etc.)
SECRET_KEY=anothersecretkey456